# ── Database ─────────────────────────────────────────────────────────
# Automatically set by Replit when you provision a PostgreSQL database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Session ──────────────────────────────────────────────────────────
# Required in production. Use a long random string (32+ chars).
# SESSION_SECRET=your-super-secret-session-key

# ── Email (Resend) ────────────────────────────────────────────────────
# Get your API key at https://resend.com
# Without this key, emails are logged to console in development mode.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Shopify Headless ─────────────────────────────────────────────────
# See SHOPIFY_SETUP.md for full setup instructions.
# Both variables must be set together for Shopify integration to activate.
# Without them, the site uses local mock product data.
#
# Your .myshopify.com domain (no https://)
# SHOPIFY_STORE_DOMAIN=turath-collective.myshopify.com
#
# Storefront API access token (from your Shopify app settings)
# SHOPIFY_STOREFRONT_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
