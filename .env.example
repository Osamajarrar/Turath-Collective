# ── Database ─────────────────────────────────────────────────────────
# PostgreSQL connection string. Required only if using custom backend features.
# Currently not needed for v1 launch (auth + contact deferred to future).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Email (Resend) ────────────────────────────────────────────────────
# Get your API key at https://resend.com
# Without this key, emails are logged to console in development mode.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Shopify Headless ─────────────────────────────────────────────────
# REQUIRED for production. See SHOPIFY_SETUP.md for full setup instructions.
# Both variables must be set together for Shopify integration to activate.
# Without them, the site uses local mock product data (in "mock" mode only).
#
# Your .myshopify.com domain (no https://)
# SHOPIFY_STORE_DOMAIN=turath-collective.myshopify.com
#
# Storefront API access token (from your Shopify app settings)
# SHOPIFY_STOREFRONT_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Shopify mode controls fallback behavior when API is unavailable:
#   "live"  - Production mode: Fail if Shopify unavailable, no fallback to mock data
#   "mock"  - Development mode: Fallback to mock data silently when API unavailable
# Default: "mock" (safe for development)
# VITE_SHOPIFY_MODE=mock

# ── Analytics (Google Analytics 4) ───────────────────────────────────
# Optional. Get your Measurement ID from your GA4 property settings.
# When not set, analytics are silently disabled (no console errors).
# Format: G-XXXXXXXXXX
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

