{
  // Tests are typechecked too. The previous config excluded `**/*.test.ts` but
  // not `**/*.test.tsx`, so component tests were checked and plain ones were
  // not — a split that hid errors in whichever half you weren't looking at.
  // api/ is gone: it held the Vercel serverless copy of the Shopify proxy,
  // which stopped serving traffic when Cloudflare took over and was deleted
  // once test/shopify-proxy.test.ts was re-pointed at the Worker. @vercel/node
  // went with it.
  //
  // worker/ is listed EXPLICITLY, and that matters: it was missing until
  // 2026-08-02, so the runtime that production will actually serve had only
  // ever been bundled by esbuild — which does not typecheck. It briefly became
  // covered by accident, because two tests import its two files, but coverage
  // that depends on a test still importing something is coverage that
  // disappears silently the day someone deletes that test.
  //
  // Cloudflare's ambient globals (ExportedHandler, KVNamespace, …) are NOT
  // available here: @cloudflare/workers-types would redefine
  // fetch/Request/Response for the whole program, including the client, which
  // needs the DOM versions. Type Worker bindings through the local `Env` type
  // instead. If worker/ ever needs the real globals, give it its own tsconfig
  // rather than widening this one.
  "include": ["client/src/**/*", "shared/**/*", "server/**/*", "test/**/*", "worker/**/*"],
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    // Was unset, so tsc defaulted to ES5 and rejected iterating a Set/Map.
    // Everything here runs in modern browsers or Node 20+.
    "target": "ES2022",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // @testing-library/jest-dom registers toBeInTheDocument/toHaveAttribute
    // on vitest's Assertion type; without it those matchers work at runtime
    // but fail `npm run check`.
    "types": ["node", "vite/client", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
